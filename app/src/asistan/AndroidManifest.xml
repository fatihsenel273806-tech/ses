<?xml version="1.0" encoding="utf-8"?>
<!-- Asistan: Dicio'nun manifestiyle birleşir (debug ve release kaynak kümeleri); Dicio dosyasına dokunulmaz -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Köprü (PROTOKOL.md): asistanın ses servisine yalnız bilinen sertifikalı uygulamalar bağlanır.
         Dört uygulama farklı anahtarla imzalı: signature yetmez, knownSigner (Android 12+) -->
    <permission
        android:name="com.ses.asistan.izin.SES"
        android:knownCerts="@array/kopru_sertifikalari"
        android:label="Asistan sesi"
        android:protectionLevel="signature|knownSigner"
        tools:targetApi="31" />

    <!-- uygulamaların köprü servisleri (uygulama kapalıyken metin devri); her uygulama kendi iznini tanımlar -->
    <uses-permission android:name="com.harita.ankara.izin.ASISTAN" />
    <!-- Notlar'ın kişisel derlemesindeki yayın alıcısı ("not al", "son notum", "notlarımda ara"; PROTOKOL.md) -->
    <uses-permission android:name="dev.kaimau.notlar.izin.ASISTAN" />
    <!-- Dosya Okuyucu'nun kişisel derlemesindeki köprü servisi ("X dosyasını aç", "sesli oku", "özetle"; PROTOKOL.md) -->
    <uses-permission android:name="com.dosyaokuyucu.dosya_okuyucu.izin.ASISTAN" />
    <!-- "Hey Harita, …" Harita kapalıyken haritayı açabilsin (arka plandan ekran açma; ayarlardan verilir) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- "İlgili uygulamalar açıkken" dinleme: önde hangi uygulama var (ayarlardan verilir, OndekiUygulama.kt) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Nota konum ("konumu da ekle"): asistan çoğu zaman arka planda, "her zaman izin ver" ayarlardan (ek/Konum.kt) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Kulak, varsayılan tanıyıcı asistanın kendisiyse Google'ınkini arar (TaniyiciSecimi; Android 11+ görünürlük) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application>
        <!-- K6 varsayılan asistan: Dicio'nun ASSIST / VOICE_COMMAND'ına ek, kulaklık düğmesine uzun basma
             (ekran açıkken WEB_SEARCH, kilitliyken VOICE_SEARCH_HANDS_FREE). VarsayilanAsistan.kt -->
        <activity
            android:name="org.stypox.dicio.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.action.WEB_SEARCH" />
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- K3 elle dinleme: uyanma bildirimindeki "Dinle / bırak" düğmesi -->
        <receiver
            android:name="com.ses.asistan.giris.ElleDinleAlici"
            android:exported="false" />

        <!-- Ekran görüntüsü ("ekran görüntüsü al, nota ekle"): yalnız takeScreenshot, olay/pencere okunmaz (ek/EkranServisi.kt) -->
        <service
            android:name="com.ses.asistan.ek.EkranServisi"
            android:exported="false"
            android:label="@string/ekran_servisi_adi"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ekran_servisi" />
        </service>

        <!-- Ekran görüntüsü Notlar'a content:// adresiyle verilir (okuma izni yalnız Notlar'a, Notlar.yaz) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.ses.asistan.ekran"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ekran_yollari" />
        </provider>

        <service
            android:name="com.ses.asistan.kopru.SesServisi"
            android:exported="true"
            android:permission="com.ses.asistan.izin.SES">
            <intent-filter>
                <action android:name="com.ses.asistan.SES" />
            </intent-filter>
        </service>
    </application>
</manifest>
